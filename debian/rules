include /usr/share/pietoolchain/rules.mk

$(OBJ)/dhcpc.o: $(SRCROOT)/dhcpc.c
	@mkdir -p $(OBJ)
	$(CC) $(BASE_CFLAGS) -c $< -o $@

$(OBJ)/dhcpc: $(OBJ)/dhcpc.o
	$(CC) $(BASE_LDFLAGS) $< -o $@

install: $(OBJ)/dhcpc
	install -d $(ROOT)/sbin
	install -m 755 $(OBJ)/dhcpc $(ROOT)/sbin/dhcpc

.PHONY: install
