#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors
set -e
[ "$1" = configure ] || exit 0
r=${DPKG_ROOT:-}
running=
if [ -n "${2:-}" ] && [ -z "$r" ]; then
	running=$(ps -axo pid=,ruid=,args= |
		awk '$2 == 0 && ($3 == "dhcpc" || $3 == "/sbin/dhcpc") { $2 = ""; print }')
	pids=$(printf '%s\n' "$running" | awk 'NF { print $1 }')
	for pid in $pids; do
		kill "$pid" 2>/dev/null || true
	done
	tries=0
	while :; do
		alive=
		for pid in $pids; do
			if kill -0 "$pid" 2>/dev/null; then
				alive=1
				break
			fi
		done
		[ -z "$alive" ] && break
		if [ "$tries" -ge 5 ]; then
			printf 'dhcpc: process %s did not stop; clients were not restarted\n' "$pid" >&2
			exit 1
		fi
		sleep 1
		tries=$((tries + 1))
	done
fi
if [ ! -L "$r/etc/resolv.conf" ]; then
	if [ -f "$r/etc/resolv.conf" ] && head -n 1 "$r/etc/resolv.conf" | grep -q '^# written by dhcpc'; then
		if [ -z "$r" ]; then
			mv -f /etc/resolv.conf /var/run/resolv.conf
		else
			rm -f "$r/etc/resolv.conf"
		fi
	fi
	if [ ! -e "$r/etc/resolv.conf" ]; then
		ln -s ../var/run/resolv.conf "$r/etc/resolv.conf"
	fi
fi
echo "$running" | awk 'NF { $1 = ""; $2 = ""; print }' | while read -r args; do
	/sbin/dhcpc $args > /dev/null 2>&1 &
done
